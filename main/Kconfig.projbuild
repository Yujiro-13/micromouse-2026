menu "reRoMouse Application"

    menu "WiFi / Telemetry"
        comment "WiFi テレメトリ・ダッシュボード (HTTP + WebSocket)。"
        comment "OFF(既定)では関連コード/依存/タスクを一切ビルド・起動せず従来挙動と同一。"
        comment "競技ビルドは n を推奨。調整・デバッグ時のみ y。"

        config RMOUSE_WIFI_ENABLE
            bool "Enable WiFi telemetry feature (master switch)"
            default n
            help
                WiFi テレメトリ機能のマスタースイッチ。
                n(既定): WiFi 関連のコード・コンポーネント・タスクは一切
                         ビルド/起動されず、従来挙動と完全に同一(OFF=無いのと同じ)。
                y      : 下記設定で WiFi(AP/STA/APSTA)・HTTP/WebSocket サーバを起動する。

        choice RMOUSE_WIFI_MODE
            prompt "WiFi mode"
            depends on RMOUSE_WIFI_ENABLE
            default RMOUSE_WIFI_MODE_APSTA
            help
                起動時の WiFi 動作モード。APSTA は AP と STA を同時に起動する。

            config RMOUSE_WIFI_MODE_AP
                bool "AP only (機体がアクセスポイント／直結)"
            config RMOUSE_WIFI_MODE_STA
                bool "STA only (既存ルータへ接続)"
            config RMOUSE_WIFI_MODE_APSTA
                bool "AP + STA (同時)"
        endchoice

        comment "--- Access Point (AP) ---"

        config RMOUSE_WIFI_AP_SSID
            string "AP SSID"
            depends on RMOUSE_WIFI_ENABLE
            default "reromouse-ap"

        config RMOUSE_WIFI_AP_PASSWORD
            string "AP password (>=8 文字, 空=オープン)"
            depends on RMOUSE_WIFI_ENABLE
            default ""
            help
                空文字でオープン(認証なし)。WPA2 にする場合は 8 文字以上。
                秘匿したい値は git 管理外の sdkconfig / sdkconfig.defaults.* へ設定すること。

        config RMOUSE_WIFI_AP_CHANNEL
            int "AP channel"
            depends on RMOUSE_WIFI_ENABLE
            range 1 13
            default 1

        config RMOUSE_WIFI_AP_MAX_CONN
            int "AP max simultaneous connections"
            depends on RMOUSE_WIFI_ENABLE
            range 1 4
            default 2

        comment "--- Station (STA) ---"

        config RMOUSE_WIFI_STA_SSID
            string "STA SSID (接続先ルータ)"
            depends on RMOUSE_WIFI_ENABLE
            default ""

        config RMOUSE_WIFI_STA_PASSWORD
            string "STA password"
            depends on RMOUSE_WIFI_ENABLE
            default ""

        config RMOUSE_WIFI_MAX_RETRY
            int "STA connection max retry"
            depends on RMOUSE_WIFI_ENABLE
            range 0 100
            default 5

        comment "--- Naming / Server ---"

        config RMOUSE_WIFI_HOSTNAME
            string "Hostname (mDNS: <name>.local)"
            depends on RMOUSE_WIFI_ENABLE
            default "reromouse"

        config RMOUSE_TELEMETRY_PORT
            int "HTTP/WebSocket server port"
            depends on RMOUSE_WIFI_ENABLE
            range 1 65535
            default 80

        config RMOUSE_TELEMETRY_HZ
            int "Telemetry push rate [Hz]"
            depends on RMOUSE_WIFI_ENABLE
            range 1 50
            default 20

        config RMOUSE_TELEMETRY_AUTH_TOKEN
            string "WebSocket auth token (空=無効)"
            depends on RMOUSE_WIFI_ENABLE
            default ""
    endmenu

    menu "Debug / Log"
        comment "ESP_LOG のレベルは Component config -> Log -> Default log verbosity で調整。"
        comment "ここでは生 printf によるトレースの有効/無効を切り替える。"

        config RMOUSE_DEBUG_BOOT_TRACE
            bool "Boot trace via printf (run_micromouse init)"
            default y
            help
                run_micromouse 初期化中の "finish ..." トレース printf を出力する。
                量産・計測時は n にしてシリアル出力を減らせる。

        config RMOUSE_DEBUG_MAINLOOP_TRACE
            bool "Main loop trace via printf"
            default n
            help
                メインループのデバッグ printf を出力する(将来配線用の予約フラグ)。
    endmenu

endmenu
